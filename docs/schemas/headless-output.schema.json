{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tugline.dev/schemas/headless-output.schema.json",
  "title": "Tugline headless output",
  "description": "tug -p … --output-format json prints one \"result\" document; --output-format stream-json prints one \"line\" per JSON line (an init line, agent events, then the result). Version 1.",
  "$defs": {
    "init": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "system"
        },
        "subtype": {
          "type": "string",
          "const": "init"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "session_id": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "permission_mode": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "subtype",
        "version",
        "session_id",
        "cwd",
        "model",
        "permission_mode",
        "tools"
      ],
      "additionalProperties": false
    },
    "event": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z_]+$"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": {}
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "result"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "session_id": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "stop_reason": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "completion": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        "stats": {
          "type": "object",
          "properties": {
            "turns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "tool_calls": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "tool_errors": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "refusals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "prompt_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "completion_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cost_usd": {
              "type": "number",
              "minimum": 0
            },
            "duration_ms": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "turns",
            "tool_calls",
            "tool_errors",
            "refusals",
            "prompt_tokens",
            "completion_tokens",
            "cost_usd",
            "duration_ms"
          ],
          "additionalProperties": false
        },
        "files_changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permission_denials": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "tool",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "type",
        "version",
        "session_id",
        "ok",
        "stop_reason",
        "result",
        "stats",
        "files_changed",
        "permission_denials"
      ],
      "additionalProperties": false
    },
    "line": {
      "anyOf": [
        {
          "$ref": "#/$defs/init"
        },
        {
          "$ref": "#/$defs/result"
        },
        {
          "$ref": "#/$defs/event"
        }
      ]
    }
  },
  "$ref": "#/$defs/result"
}
