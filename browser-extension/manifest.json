{
  "manifest_version": 3,
  "name": "Tugline",
  "version": "1.1.0",
  "description": "Lets your local Tugline agent act in browser tabs you explicitly share, with site limits and a stop button.",
  "minimum_chrome_version": "125",
  "permissions": ["debugger", "tabs", "storage"],
  "background": { "service_worker": "sw.js", "type": "module" },
  "action": { "default_title": "Share this tab with Tugline", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
